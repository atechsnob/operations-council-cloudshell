# Copy this file to .env and fill in your values.
# `source .env` (or use python-dotenv) before running any chapter.

# --- Google Cloud project ---
PROJECT_ID="your-gcp-project-id"
PROJECT_NUMBER="000000000000"
REGION="us-central1"

# --- Agent Platform settings ---
GOOGLE_GENAI_USE_VERTEXAI="TRUE"
GOOGLE_CLOUD_PROJECT="${PROJECT_ID}"
GOOGLE_CLOUD_LOCATION="${REGION}"

# --- Models (update as new versions ship) ---
MODEL_PRO="gemini-3.1-pro"
MODEL_FLASH="gemini-3-flash"

# --- BigQuery ---
BQ_DATASET="operations_council"
BQ_KB_TABLE="knowledge_base"

# --- Artifact Registry (Chapter 7) ---
REPO_NAME="operations-council-repo"

# --- Service account ---
SERVICE_ACCOUNT_NAME="operations-council-sa@${PROJECT_ID}.iam.gserviceaccount.com"
